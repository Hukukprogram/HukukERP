<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HukukErp</RootNamespace>
    <AssemblyName>HukukERP</AssemblyName>
    <StartupObject>HukukErp.Program</StartupObject>
    <Version>1.0.0</Version>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8604;CS8600;CS8601;CS8603;CS8625;CS8765;CS8767</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Globalization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="MailKit" Version="4.7.1.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="Velopack" Version="0.0.942" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test projesi ayrı derlenir; ana programa karışmasın -->
    <Compile Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tebligat_sureleri.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="guncelleme.txt" CopyToOutputDirectory="PreserveNewest" Condition="Exists('guncelleme.txt')" />
  </ItemGroup>

</Project>
